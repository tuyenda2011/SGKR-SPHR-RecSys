# Data & Artifacts (track manifest.json, ignore large data)
data/raw/
data/cache/
data/source/
data/versions/*
# The active build's immutable archive is tracked: train_suite pins it (same blobs as data/processed)
!data/versions/build_bed0f5b7efb9e7a0a148e2c071540e30/
data/exported/
data/.bundle.lock
!data/manifest.json
!data/current.json
artifacts/
*.log
*.pt
*.pth
*.parquet
*.pkl
*.npy
*.npz
# The processed data bundle is tracked (so a fresh clone, e.g. on Kaggle, can train directly)
!data/processed/**
!data/versions/build_bed0f5b7efb9e7a0a148e2c071540e30/**
# Results: only the final trained checkpoint of each model/size/seed is tracked
results/**
!results/**/
!results/*/*/*/checkpoint.pt
!results/*/*/*/checkpoint.npz
!results/**/*history.csv
# Reports: only the figures (PNG) are tracked
reports/**
!reports/**/
!reports/**/*.png

# DVC
.dvc/cache
.dvc/tmp
.dvc/plots

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

